# Copy to infrastructure/docker/.env before running docker compose.
# These values are for local Docker development only.

POSTGRES_USER=achflow
POSTGRES_PASSWORD=achflow
POSTGRES_DB=achflow

DATABASE_URL=postgresql://achflow:achflow@postgres:5432/achflow?schema=public
REDIS_URL=redis://redis:6379

API_PORT=3000
WEB_PORT=3001

MERCHANT_API_KEY_HASH_SECRET=local-dev-merchant-api-key-hash-secret
ACHFLOW_ADMIN_API_KEY=local-dev-admin-key
WEBHOOK_SECRET_ENCRYPTION_KEY=QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQQ==
WEBHOOK_SECRET_ENCRYPTION_KEY_VERSION=v1

PAYMENT_API_RATE_LIMIT_MAX_REQUESTS=100
PAYMENT_API_RATE_LIMIT_WINDOW_SECONDS=60
PAYMENT_API_RATE_LIMIT_NAMESPACE=achflow:payment-rate-limit

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
API_BASE_URL=http://api:3000/api/v1
ACHFLOW_API_KEY=replace-after-seeding-merchant-api-key
ACHFLOW_ADMIN_API_KEY=local-dev-admin-key
