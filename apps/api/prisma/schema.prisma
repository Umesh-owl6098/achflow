generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentDirection {
  DEBIT
  CREDIT
}

enum PaymentStatus {
  RECEIVED
  VALIDATED
  VALIDATION_FAILED
  PENDING
  PROCESSING
  SUBMITTED
  SETTLED
  RETURNED
  FAILED
  CANCELLED
  UNKNOWN
}

enum OutboxEventType {
  PAYMENT_RECEIVED
  PAYMENT_VALIDATED
  PAYMENT_VALIDATION_FAILED
  PAYMENT_RESERVED
  PAYMENT_SUBMITTED
  PAYMENT_SETTLED
  PAYMENT_RETURNED
  WEBHOOK_TEST
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum SimulatorRunStatus {
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
  FAILED
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum FundingAccountStatus {
  ACTIVE
  CLOSED
}

enum LedgerEntryType {
  INITIAL_CREDIT
  RESERVATION
  RESERVATION_RELEASE
  SETTLEMENT
  DEBIT_POSTED
  CREDIT_POSTED
  RETURN
  REVERSAL
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  SETTLED
  RETURNED
}

model Merchant {
  id                 String                     @id @default(uuid())
  merchantCode       String                     @unique
  legalName          String
  displayName        String
  status             MerchantStatus             @default(ACTIVE)
  allowAchDebit      Boolean                    @default(false)
  allowAchCredit     Boolean                    @default(false)
  perPaymentLimit    BigInt                     @default(10000)
  dailyAmountLimit   BigInt                     @default(100000)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  payments           Payment[]
  dailyUsage         MerchantDailyUsage[]
  fundingAccounts    FundingAccount[]
  idempotencyRecords PaymentIdempotencyRecord[]
  apiKey             MerchantApiKey?
  webhookEndpoints   MerchantWebhookEndpoint[]
  webhookDeliveries  WebhookDelivery[]
}

model MerchantWebhookEndpoint {
  id                      String   @id @default(uuid())
  merchantId              String
  url                     String
  encryptedSigningSecret  String
  signingSecretIv         String
  signingSecretAuthTag    String
  signingSecretKeyVersion String
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  merchant   Merchant          @relation(fields: [merchantId], references: [id])
  deliveries WebhookDelivery[]

  @@index([merchantId, isActive])
}

model MerchantApiKey {
  id           String   @id @default(uuid())
  merchantId   String   @unique
  hashedApiKey String   @unique
  createdAt    DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
}

model FundingAccount {
  id           String               @id @default(uuid())
  merchantId   String
  currency     String               @default("USD")
  status       FundingAccountStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  merchant     Merchant             @relation(fields: [merchantId], references: [id])
  entries      LedgerEntry[]
  reservations Reservation[]

  @@unique([merchantId, currency])
}

model LedgerEntry {
  id               String          @id @default(uuid())
  entryKey         String          @unique
  fundingAccountId String
  paymentId        String?
  entryType        LedgerEntryType
  amount           BigInt
  createdAt        DateTime        @default(now())
  fundingAccount   FundingAccount  @relation(fields: [fundingAccountId], references: [id])

  @@index([fundingAccountId, createdAt])
  @@index([paymentId])
}

model Reservation {
  id               String            @id @default(uuid())
  paymentId        String            @unique
  fundingAccountId String
  amount           BigInt
  status           ReservationStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  releasedAt       DateTime?
  settledAt        DateTime?
  returnedAt       DateTime?
  returnCode       String?
  fundingAccount   FundingAccount    @relation(fields: [fundingAccountId], references: [id])

  @@index([fundingAccountId, status])
}

model MerchantDailyUsage {
  id             String   @id @default(uuid())
  merchantId     String
  businessDate   DateTime @db.Date
  utilizedAmount BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, businessDate])
  @@index([businessDate])
}

model Payment {
  id                 String           @id @default(uuid())
  idempotencyKey     String           @unique
  requestFingerprint String
  externalReference  String?
  direction          PaymentDirection
  status             PaymentStatus    @default(RECEIVED)
  amountCents        BigInt
  currency           String           @default("USD")
  merchantId         String
  receiverName       String
  receiverAccountRef String
  routingNumber      String
  description        String?
  failureCode        String?
  failureReason      String?
  validationCode     String?
  validationMessage  String?
  validatedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  exportedAt         DateTime?
  achFileId          String?

  merchant             Merchant                  @relation(fields: [merchantId], references: [id])
  bankSettlementEvents ProcessedBankEvent[]
  idempotencyRecord    PaymentIdempotencyRecord?
  achFile              AchFile?                  @relation(fields: [achFileId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([merchantId])
}

model AchFile {
  id                 String    @id @default(uuid())
  fileName           String    @unique
  companyId          String
  effectiveEntryDate DateTime  @db.Date
  status             String
  totalEntries       Int
  debitTotalCents    BigInt
  creditTotalCents   BigInt
  entryHash          String
  sha256             String
  createdAt          DateTime  @default(now())
  payments           Payment[]

  @@index([companyId, effectiveEntryDate])
}

model PaymentIdempotencyRecord {
  id                 String   @id @default(uuid())
  merchantId         String
  idempotencyKey     String
  requestFingerprint String
  paymentId          String   @unique
  createdAt          DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@unique([merchantId, idempotencyKey])
}

model ProcessedBankEvent {
  id             String   @id @default(uuid())
  bankEventId    String   @unique
  paymentId      String
  eventType      String
  eventTimestamp DateTime
  processedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model OutboxEvent {
  id            String            @id @default(uuid())
  eventKey      String            @unique @default(uuid())
  eventType     OutboxEventType
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  claimedAt     DateTime?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deliveries    WebhookDelivery[]

  @@index([status, availableAt])
  @@index([status, claimedAt])
  @@index([aggregateType, aggregateId])
}

model WebhookDelivery {
  id                String                @id @default(uuid())
  merchantId        String
  webhookEndpointId String
  outboxEventId     String
  eventId           String                @unique
  eventType         String
  payload           Json
  status            WebhookDeliveryStatus @default(PENDING)
  attemptCount      Int                   @default(0)
  nextAttemptAt     DateTime?             @default(now())
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  responseStatus    Int?
  lastErrorCode     String?
  claimedAt         DateTime?
  claimedBy         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  merchant        Merchant                @relation(fields: [merchantId], references: [id])
  webhookEndpoint MerchantWebhookEndpoint @relation(fields: [webhookEndpointId], references: [id])
  outboxEvent     OutboxEvent             @relation(fields: [outboxEventId], references: [id])

  @@unique([webhookEndpointId, outboxEventId])
  @@index([status, nextAttemptAt])
  @@index([claimedAt])
  @@index([merchantId])
  @@index([webhookEndpointId])
}

model WorkerHeartbeat {
  workerId                  String   @id
  lastSeenAt                DateTime
  nachaGenerationEnabled    Boolean
  nachaGenerationIntervalMs Int
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([lastSeenAt])
}

model SimulatorRun {
  id                String             @id @default(uuid())
  status            SimulatorRunStatus @default(RUNNING)
  configuration     Json
  merchantIds       Json
  startedAt         DateTime           @default(now())
  completedAt       DateTime?
  generatedCount    Int                @default(0)
  successfulCount   Int                @default(0)
  failedCount       Int                @default(0)
  returnedCount     Int                @default(0)
  averageLatencyMs  Int                @default(0)
  failureSummary    Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([createdAt])
  @@index([status])
}
