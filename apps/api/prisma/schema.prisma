generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentDirection {
  DEBIT
  CREDIT
}

enum PaymentStatus {
  RECEIVED
  VALIDATED
  VALIDATION_FAILED
  PENDING
  PROCESSING
  SUBMITTED
  SETTLED
  RETURNED
  FAILED
  CANCELLED
  UNKNOWN
}

enum OutboxEventType {
  PAYMENT_RECEIVED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum FundingAccountStatus {
  ACTIVE
  CLOSED
}

enum LedgerEntryType {
  INITIAL_CREDIT
  RESERVATION
  RESERVATION_RELEASE
  SETTLEMENT
  DEBIT_POSTED
  CREDIT_POSTED
  RETURN
  REVERSAL
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  SETTLED
  RETURNED
}

model Merchant {
  id               String               @id @default(uuid())
  merchantCode     String               @unique
  legalName        String
  displayName      String
  status           MerchantStatus       @default(ACTIVE)
  allowAchDebit    Boolean              @default(false)
  allowAchCredit   Boolean              @default(false)
  perPaymentLimit  BigInt
  dailyAmountLimit BigInt
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  payments         Payment[]
  dailyUsage       MerchantDailyUsage[]
  fundingAccounts  FundingAccount[]
}

model FundingAccount {
  id           String               @id @default(uuid())
  merchantId   String
  currency     String               @default("USD")
  status       FundingAccountStatus @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  merchant     Merchant             @relation(fields: [merchantId], references: [id])
  entries      LedgerEntry[]
  reservations Reservation[]

  @@unique([merchantId, currency])
}

model LedgerEntry {
  id               String          @id @default(uuid())
  entryKey         String          @unique
  fundingAccountId String
  paymentId        String?
  entryType        LedgerEntryType
  amount           BigInt
  createdAt        DateTime        @default(now())
  fundingAccount   FundingAccount  @relation(fields: [fundingAccountId], references: [id])

  @@index([fundingAccountId, createdAt])
  @@index([paymentId])
}

model Reservation {
  id               String            @id @default(uuid())
  paymentId        String            @unique
  fundingAccountId String
  amount           BigInt
  status           ReservationStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  releasedAt       DateTime?
  settledAt        DateTime?
  returnedAt       DateTime?
  returnCode       String?
  fundingAccount   FundingAccount    @relation(fields: [fundingAccountId], references: [id])

  @@index([fundingAccountId, status])
}

model MerchantDailyUsage {
  id             String   @id @default(uuid())
  merchantId     String
  businessDate   DateTime @db.Date
  utilizedAmount BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, businessDate])
  @@index([businessDate])
}

model Payment {
  id                 String           @id @default(uuid())
  idempotencyKey     String           @unique
  requestFingerprint String
  externalReference  String?
  direction          PaymentDirection
  status             PaymentStatus    @default(RECEIVED)
  amountCents        BigInt
  currency           String           @default("USD")
  merchantId         String
  receiverName       String
  receiverAccountRef String
  routingNumber      String
  description        String?
  failureCode        String?
  failureReason      String?
  validationCode     String?
  validationMessage  String?
  validatedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])
  bankSettlementEvents ProcessedBankEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([merchantId])
}

model ProcessedBankEvent {
  id             String   @id @default(uuid())
  bankEventId    String   @unique
  paymentId      String
  eventType      String
  eventTimestamp DateTime
  processedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model OutboxEvent {
  id            String            @id @default(uuid())
  eventType     OutboxEventType
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  claimedAt     DateTime?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([status, claimedAt])
  @@index([aggregateType, aggregateId])
}
