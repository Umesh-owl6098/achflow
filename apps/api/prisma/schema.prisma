generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentDirection {
  DEBIT
  CREDIT
}

enum PaymentStatus {
  RECEIVED
  VALIDATED
  VALIDATION_FAILED
  PENDING
  PROCESSING
  SUBMITTED
  SETTLED
  RETURNED
  FAILED
  CANCELLED
  UNKNOWN
}

enum OutboxEventType {
  PAYMENT_RECEIVED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Merchant {
  id               String               @id @default(uuid())
  merchantCode     String               @unique
  legalName        String
  displayName      String
  status           MerchantStatus       @default(ACTIVE)
  allowAchDebit    Boolean              @default(false)
  allowAchCredit   Boolean              @default(false)
  perPaymentLimit  BigInt
  dailyAmountLimit BigInt
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  payments         Payment[]
  dailyUsage       MerchantDailyUsage[]
}

model MerchantDailyUsage {
  id             String   @id @default(uuid())
  merchantId     String
  businessDate   DateTime @db.Date
  utilizedAmount BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, businessDate])
  @@index([businessDate])
}

model Payment {
  id                 String           @id @default(uuid())
  idempotencyKey     String           @unique
  requestFingerprint String
  externalReference  String?
  direction          PaymentDirection
  status             PaymentStatus    @default(RECEIVED)
  amountCents        BigInt
  currency           String           @default("USD")
  merchantId         String
  receiverName       String
  receiverAccountRef String
  routingNumber      String
  description        String?
  failureCode        String?
  failureReason      String?
  validationCode     String?
  validationMessage  String?
  validatedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([merchantId])
}

model OutboxEvent {
  id            String            @id @default(uuid())
  eventType     OutboxEventType
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  claimedAt     DateTime?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([status, claimedAt])
  @@index([aggregateType, aggregateId])
}
