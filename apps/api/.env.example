DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/achflow?schema=public"
PORT=3000
MERCHANT_API_KEY_HASH_SECRET="replace-with-a-base64-secret"
ACHFLOW_ADMIN_API_KEY="replace-with-a-local-admin-key"
SIMULATOR_ENABLED=false
REDIS_URL="redis://localhost:6379"
PAYMENT_API_RATE_LIMIT_MAX_REQUESTS=100
PAYMENT_API_RATE_LIMIT_WINDOW_SECONDS=60
PAYMENT_API_RATE_LIMIT_NAMESPACE=achflow:payment-rate-limit
WEBHOOK_SECRET_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
WEBHOOK_SECRET_ENCRYPTION_KEY_VERSION=v1
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_INITIAL_RETRY_SECONDS=1
WEBHOOK_MAX_RETRY_SECONDS=60
WEBHOOK_REQUEST_TIMEOUT_MS=5000
WEBHOOK_BATCH_SIZE=25
WEBHOOK_CLAIM_TIMEOUT_SECONDS=60
WEBHOOK_WORKER_ID=api-webhook-worker
WORKER_HEARTBEAT_STALE_SECONDS=30
