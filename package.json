{
  "name": "achflow",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade ACH payment processing and reconciliation platform.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "echo \"Run app-specific dev commands\"",
    "web:dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "eval": "node --experimental-strip-types evals/run-evals.ts --all",
    "eval:deterministic": "node --experimental-strip-types evals/run-evals.ts --category deterministic",
    "eval:consistency": "node --experimental-strip-types evals/run-evals.ts --category consistency",
    "eval:regex": "node --experimental-strip-types evals/run-evals.ts --category regex",
    "eval:red-team": "node --experimental-strip-types evals/run-evals.ts --category red-team",
    "eval:regression": "node --experimental-strip-types evals/run-evals.ts --category regression",
    "format": "prettier --write .",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf {} +"
  },
  "keywords": [
    "payments",
    "ach",
    "fintech",
    "nestjs",
    "react",
    "ledger",
    "reconciliation"
  ],
  "license": "MIT"
}
